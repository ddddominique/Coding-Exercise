class Solution {
public:
    vector<int> findMissingElements(vector<int>& nums) {
        sort(nums.begin(), nums.end());

        vector<int> result;
        int j = 0;
        for (int i = nums[0]; i <= nums[nums.size()-1]; ++i) {

            if (i < nums[j]) {result.push_back(i);}
            else j++;

        }
        return result;
    }

};
