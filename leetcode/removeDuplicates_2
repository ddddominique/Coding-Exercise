class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
        int index = 0;
        int hold = 1;
        for (int i = 1; i < nums.size(); ++i) {
            if (nums[index] != nums[i]) {
                index++;
                nums[index] = nums[i];
                hold = 1;
            } else if (hold == 1) {
                index++;
                nums[index] = nums[i];
                hold--;
            } 
        }
            return index + 1;

    }
};
