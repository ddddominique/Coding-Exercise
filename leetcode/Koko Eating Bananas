class Solution {
    bool isValidate(vector<int>& piles, int h, int rate) {
        int result = 0;
        for (int pile : piles) {
            result += ceil((double)pile/rate);
        }
        return result <= h;
    }
public:
    int minEatingSpeed(vector<int>& piles, int h) {
        int l = 1;
        int r = *max_element(piles.begin(), piles.end());
        while (l < r) {
            int mid = l + (r - l) / 2;
            if (isValidate(piles, h, mid)) {
                r = mid;
            } else {
                l = mid + 1;
            }
        }
        return l;
    }
};