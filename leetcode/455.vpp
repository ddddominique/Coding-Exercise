class Solution {
public:
    int findContentChildren(vector<int>& g, vector<int>& s) {
        int result = 0;
        sort(g.begin(), g.end());
        sort(s.begin(), s.end());
        int counter = 0;
        for (int i = 0; i < g.size(); ++i) {
            while (counter < s.size()) {
                if (s[counter] >= g[i]) {
                    result++;
                    counter++;
                    break;

                } else {
                    counter++;
                }
            }
        }
        return result;
    }
};