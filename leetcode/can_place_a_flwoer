class Solution {
public:
    bool canPlaceFlowers(vector<int>& flowerbed, int n) {
        if (n == 0) return true;
        if (flowerbed.size() == 1) {
            return flowerbed[0] == 0;
        }
        int prev = 0, next = 0;
        int result = 0;
        for (int i = 0; i < flowerbed.size(); ++i) {
            if (i == 0) {
                if (!flowerbed[i] && !flowerbed[1]) {
                    result++;
                    flowerbed[0] = 1;
                }
            } else if (i == flowerbed.size() - 1) {
                if (!flowerbed[i] && !flowerbed[i - 1]) {
                    result++;
                    flowerbed[i] = 1;
                }
            } else {
                if (!flowerbed[i] && !flowerbed[i - 1] && !flowerbed[i + 1]) {
                    result++;
                    flowerbed[i] = 1;
                }
            }
        }
        return result >= n;
    }
};